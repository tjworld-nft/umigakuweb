# Directory index configuration
DirectoryIndex index.html

# FTPデプロイの同期記録（全ファイル一覧+ハッシュ）を外部から読めなくする。
# ファイル自体は消さないこと（消すと次回デプロイがフル再アップロードになる）。
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# RewriteEngine On
RewriteEngine On

# Canonical URL (2026-08-19): http→https / www→non-www / どのディレクトリでも index.html→末尾スラッシュ
# Xserver（nginx前段＋Apache）では %{HTTPS} が使える（公式案内のスニペットと同じ書き方）
# 注意(2026-08-26): サブドメイン（logbook.miura-diving.com 等）のドキュメントルートは
# public_html 配下のディレクトリで、この .htaccess のルールを継承する。
# ホスト条件で本体ドメインに限定しないと、logbook の /index.html（PWAのstart_url）が
# 存在しないURLへ301されて404になる。以下の2ブロックのホスト条件は外さないこと。
RewriteCond %{HTTP_HOST} ^(www\.)?miura-diving\.com$ [NC]
RewriteCond %{HTTPS} !on [OR]
RewriteCond %{HTTP_HOST} ^www\.miura-diving\.com$ [NC]
RewriteRule ^(.*)$ https://miura-diving.com/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?miura-diving\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# 本体ドメイン経由でサブドメインdocrootに直アクセスされたら本来のサブドメインへ戻す。
# 上記の誤爆301がSafariに永続キャッシュされた端末の受け皿（301だと再汚染するので302）。
# 別オリジンでログブックが開くとlocalStorageが空に見える事故の防止も兼ねる。
RewriteCond %{HTTP_HOST} ^(www\.)?miura-diving\.com$ [NC]
RewriteRule ^logbook\.miura-diving\.com(?:/(.*))?$ https://logbook.miura-diving.com/$1 [R=302,L]

# Make /blog unaffected by WP rules (if any)
RewriteRule ^blog($|/) - [L]

# Canonical redirects to new clean URLs - using RewriteRule to avoid conflicts
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+license-preview\.html[\s?] [NC]
RewriteRule ^license-preview\.html$ /license/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+fun-diving/index\.html[\s?] [NC]
RewriteRule ^fun-diving/index\.html$ /fun-diving/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+marine-activity/index\.html[\s?] [NC]
RewriteRule ^marine-activity/index\.html$ /marine-activity/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contact\.html[\s?] [NC]
RewriteRule ^contact\.html$ /contact [R=301,L]

RewriteCond %{THE_REQUEST} \s/+privacy\.html[\s?] [NC]
RewriteRule ^privacy\.html$ /privacy [R=301,L]

RewriteCond %{THE_REQUEST} \s/+owd-lp\.html[\s?] [NC]
RewriteRule ^owd-lp\.html$ /license/ [R=301,L]

# Consolidate overlapping SEO landing pages into the primary pages.
RewriteRule ^kanagawa-diving-school/?$ / [R=301,L]
RewriteRule ^owd-license/?$ /license/ [R=301,L]
RewriteRule ^diving-license\.php$ /license/ [R=301,L]
RewriteRule ^fun-diving\.php$ /fun-diving/ [R=301,L]
RewriteRule ^marine-activity\.php$ /marine-activity/ [R=301,L]
RewriteRule ^owd-lp\.php$ /license/ [R=301,L]
RewriteRule ^aow-course\.php$ /license/ [R=301,L]
RewriteRule ^dsd\.php$ /license/ [R=301,L]
RewriteRule ^refresh-dive\.php$ /fun-diving/ [R=301,L]
RewriteRule ^front-page\.php$ / [R=301,L]
RewriteRule ^page-home-test\.php$ / [R=301,L]
RewriteRule ^preview\.html$ / [R=301,L]
RewriteRule ^license-(all|complete|simple)-preview\.html$ /license/ [R=301,L]
RewriteRule ^owd-template\.php$ /license/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+game\.html[\s?] [NC]
RewriteRule ^game\.html$ /game [R=301,L]

# Internal rewrites for clean URLs (no redirect, just serve the file)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^contact/?$ contact.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^privacy/?$ privacy.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^license/?$ license/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^beginner-guide/?$ beginner-guide/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^kanagawa-diving-license/?$ kanagawa-diving-license/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^fun-diving/?$ fun-diving/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^marine-activity/?$ marine-activity/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^owd-license/?$ owd-lp.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^game/?$ game.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^games/?$ games/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^games/puzzle/?$ games/puzzle/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^beginner-diving-guide/?$ beginner-diving-guide/index.html [L]

SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=off
SetEnvIf Request_URI ".*" Ngx_Cache_AllCacheMode
SetEnvIf Request_URI ".*" AllowRestApi

# Disable all rewrite rules to isolate the source of the redirect loop

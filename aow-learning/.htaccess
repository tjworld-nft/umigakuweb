DirectoryIndex index.php
Options -Indexes

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?miura-diving\.com$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Course content is served only after index.php authenticates the viewer.
<FilesMatch "\.html$">
  Require all denied
</FilesMatch>

<FilesMatch "^access-config.*\.php$">
  Require all denied
</FilesMatch>

# SQLiteはWALモードなので -wal / -shm も塞ぐ。直前に書かれた行がそのまま入っている。
<FilesMatch "\.(sqlite|sqlite3|db|bak|sql)(-wal|-shm|-journal)?$">
  Require all denied
</FilesMatch>
